article/*.bbl
article/*.blg
article/*.fdb_latexmk
article/*.fls
article/*.log
article/*.out
article/main.aux
article/main.bbl
article/main.blg
article/main.fdb_latexmk
article/main.fls

# Byte-compiled metadata
*.egg-info/
