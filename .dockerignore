# VCS and local env
.git/
.gitignore
.venv/

# Python caches
**/__pycache__/
**/*.pyc
**/*.pyo

# Logs and checkpoints
logs/
logs_backup_*/
**/*.ckpt

# Large generated figures and PDFs
figures/*/*.pdf
figures/*/*.png

# LaTeX build artifacts
